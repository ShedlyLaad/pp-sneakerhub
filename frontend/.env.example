# Copy to .env and set to your dev machine's LAN IP so a physical phone
# running Expo Go can reach the backend. Find your IP with:
#   Windows:      ipconfig            (look for "IPv4 Address" under Wi-Fi)
#   macOS/Linux:  ifconfig | grep inet
# Not needed for the Android emulator or iOS simulator - they resolve the
# backend automatically (see services/api/client.js).
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api
